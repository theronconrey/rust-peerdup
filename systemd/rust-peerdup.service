# SPDX-License-Identifier: MIT
#
# The per-user daemon. Shipped in /usr/lib/systemd/user by the RPM; install.sh
# rewrites ExecStart for a ~/.local/bin install. The session bus starts it on
# the first CLI call (org.peerdup.Daemon1.service), or enable it at login with
#   systemctl --user enable --now rust-peerdup

#
# No inbound port is needed: iroh connects out, hole-punches, and falls back
# to a relay. Several users on one machine don't collide.

[Unit]
Description=rust-peerdup encrypted folder sync daemon
Documentation=man:rust-peerdup(1) https://github.com/theronconrey/rust-peerdup
# No network-online.target: a user unit can't order against system units.
# The daemon copes with the network coming and going on its own.

[Service]
# systemd tracks the bus name, so D-Bus activation waits for the daemon to
# claim it, and a daemon that can't claim it fails instead of running
# without IPC.
Type=dbus
BusName=org.peerdup.Daemon1
ExecStart=/usr/bin/rust-peerdup serve
Restart=on-failure
RestartSec=5
Environment=RUST_LOG=rust_peerdup=info

# Sandboxing. A user unit can only use the options that need no privileges
# (seccomp and friends): the mount-namespace ones (ProtectSystem=,
# ProtectHome=, PrivateTmp=) are left out because share roots can be
# anywhere in the user's home and the daemon must read and write them.
NoNewPrivileges=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# AF_UNIX: the session bus. AF_INET/AF_INET6: peers. AF_NETLINK: iroh
# watches network interfaces to pick addresses to announce.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=default.target
